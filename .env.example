# ─── Email / Resend ────────────────────────────────────────────────────────────
# Resend API key used to send lead notification and result emails.
# If unset, email delivery is skipped and a warning is logged.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "From" address for all outbound email. Must be a Resend-verified domain.
EMAIL_FROM=UnflakeOps <hello@unflakeops.com>

# Internal address that receives a copy of every inbound lead notification.
# Leave unset to disable internal notifications.
EMAIL_BCC_LEADS=team@example.com

# ─── Telegram (optional) ───────────────────────────────────────────────────────
# Telegram Bot token (from @BotFather) for real-time lead alerts.
# Both vars must be set; if either is absent, Telegram delivery is skipped.
TELEGRAM_BOT_TOKEN=1234567890:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numeric chat / channel ID the bot posts to.
TELEGRAM_CHAT_ID=-1001234567890

# ─── PostHog (optional) ────────────────────────────────────────────────────────
# Server-side PostHog write key for capturing lead_submitted events.
# If unset, server-side capture is skipped.
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── HubSpot (optional) ────────────────────────────────────────────────────────
# HubSpot Private App token (CRM Contacts scope) for contact upsert.
# If unset, HubSpot sync is skipped gracefully.
HUBSPOT_PRIVATE_APP_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# HubSpot Portal / Hub ID — used for reference and deep-link generation.
HUBSPOT_PORTAL_ID=12345678

# ─── Public / site config ──────────────────────────────────────────────────────
# NOTE: Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle at
# build time and visible to all end-users. Do not put secrets here.

# Canonical site URL — used in sitemap.xml, robots.txt, and og: tags.
NEXT_PUBLIC_SITE_URL=https://unflakeops.com

# PostHog ingestion host. Defaults to EU cloud if unset.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Text shown in the site header badge (e.g. region or partner label).
NEXT_PUBLIC_REGION_BADGE=EU

# Discovery-call booking URL. Defaults to /call, which redirects to Google Calendar.
NEXT_PUBLIC_BOOKING_URL=/call

# Public contact email address displayed in the UI.
NEXT_PUBLIC_CONTACT_EMAIL=hello@unflakeops.com
